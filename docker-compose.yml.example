services:
  db:
    image: postgres:15-alpine
    container_name: medsync-db
    environment:
      POSTGRES_USER: flyway_user
      POSTGRES_PASSWORD: ${DB_PASSWORD:-local_dev_password}
      POSTGRES_DB: mydb
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U flyway_user -d mydb"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: medsync-redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

  flyway:
    image: flyway/flyway:10-alpine
    container_name: medsync-flyway
    command: -url=jdbc:postgresql://db:5432/mydb -user=flyway_user -password=${DB_PASSWORD:-local_dev_password} migrate
    volumes:
      - ./Database:/flyway/sql
    depends_on:
      db:
        condition: service_healthy

volumes:
  postgres_data:
  redis_data:
